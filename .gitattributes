# Normalize line endings to LF on checkout
* text=auto eol=lf

# Explicit LF text files
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.vue text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.sql text eol=lf
*.conf text eol=lf
Dockerfile text eol=lf

# Windows-native scripts keep CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Explicitly set binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.ttf binary
*.woff binary
*.woff2 binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.jar binary
*.class binary
*.pyc binary
*.pyo binary
*.db binary
*.sqlite binary
*.sqlite3 binary
