# Semantic-Atlas 环境配置模板
# 复制此文件为 .env 并填入实际值

# ============================================
# 模型提供方配置
# ============================================

# DeepSeek API (当 MODEL_PROVIDER=deepseek 时使用)
DEEPSEEK_API_KEY=?
DEEPSEEK_API_URL=https://api.deepseek.com
# Available models: deepseek-v4-pro, deepseek-flash
DEEPSEEK_MODEL=deepseek-v4-pro

# Chutes API (当 MODEL_PROVIDER=chutes 时使用)
CHUTES_API_TOKEN=your_chutes_api_token_here
CHUTES_API_URL=https://chutes.ai/api/v1

# ============================================
# FRP 内网穿透配置
# ============================================

# FRP 服务器地址
FRP_SERVER_ADDR=your_frp_server_ip

# FRP 服务器密码
FRP_TOKEN=your_frp_token

# ============================================
# 数据库配置 (可选，有默认值)
# ============================================

# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=semantic_atlas
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/semantic_atlas

# ============================================
# 服务配置 (可选，有默认值)
# ============================================

# MODEL_PROVIDER=local
# INFERENCE_URL=http://localhost:8000
# CORS_ORIGINS=http://localhost:8008
# 知识库向量检索 embedding 模型（backend_inference/services/kb_service）
# KB_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# 模型本地目录根路径（默认 data/model）
# MODEL_DATA_DIR=data/model
# 需求图谱同类相似 embedding 模型 ID 或本地目录（默认自动下载到 data/model/requirement_graph_embedding）
# REQUIREMENT_GRAPH_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# REQUIREMENT_GRAPH_EMBEDDING_DIR=data/model/requirement_graph_embedding
# SessionController 当前为 graph-only 主路径，不再使用 SESSION_CONTROLLER_GRAPH_ENABLED。

# ============================================
# Remote ASR (VibeVoice) 配置
# ============================================

# 业务后端调用远端推理服务（通常是通过 FRP 暴露的地址）
# ASR_REMOTE_BASE_URL=http://<FRPS_IP>:18000
# ASR_REMOTE_TRANSCRIBE_PATH=/asr/transcribe
# ASR_REMOTE_HEALTH_PATH=/asr/health
# ASR_REMOTE_AUTH_TOKEN=
# ASR_REMOTE_TIMEOUT_SECONDS=1800
# ASR_MAX_UPLOAD_MB=200
# ASR_ALLOWED_EXTENSIONS=wav,mp3,m4a,mp4

# 远端推理服务模型配置（部署在 AutoDL）
# VIBEVOICE_ASR_MODEL=microsoft/VibeVoice-ASR-HF
# ASR_AUTO_WARMUP=false
# ASR_SERVICE_TOKEN=
# VISION_CAPTION_URL=http://your-autodl-host:9000/caption-image
# VISION_SERVICE_TOKEN=your_vision_service_token
# VISION_CAPTION_TIMEOUT_SECONDS=120
